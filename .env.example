# The demo reads process environment; it does not automatically load this file.
MUSE_EMAIL=user@example.com
# Password and OTP come from the caller. Leave this blank for OTP login.
MUSE_PASSWORD=
# Optional existing session for --auth cookie; never commit a real cookie.
MUSE_COOKIE=
# Empty inherits proxy environment; direct bypasses proxies.
MUSE_PROXY=direct
